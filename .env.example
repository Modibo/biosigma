# BioSigma — variables d'environnement (déploiement).
# Copiez ce fichier en .env avant de lancer install-caddy.sh ou docker compose.
# Aucun secret ici : l'application est statique, sans base de données.

# Port de la machine hôte sur lequel le conteneur est publié, en loopback
# seulement (127.0.0.1:HOST_PORT). Changez si 8081 sert déjà à autre chose.
HOST_PORT=8081

# Nom du réseau Docker de la façade Caddy (uniquement si Caddy tourne
# lui-même en conteneur, ce qui est le cas sur ce VPS). Valeur déjà connue,
# réutilisée de PhénoBac :
PROXY_NETWORK=nexolab-api_default
